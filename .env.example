# 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#
#   PowerShell:  Copy-Item .env.example .env.local
#
# NEXT_PUBLIC_* 두 개는 Supabase 대시보드 → Project Settings → API 에 있습니다.
# 값을 바꾼 뒤에는 `next dev` 를 다시 시작해야 반영됩니다.
# 배포 환경(Vercel)에도 같은 값들을 등록해야 합니다 — Production/Preview 모두
# (아래 공개/서버 전용 값을 역할에 맞게 등록. AI 키는 없어도 앱은 키워드 검색으로 동작).
#
# ⚠️ Supabase 프로젝트 필수 설정 (키만 채워서는 안전하지 않습니다)
#
#   1. Authentication → Sign In / Up → "Allow new users to sign up" **끄기**
#      (익명 로그인도 같은 화면에서 끕니다).
#      켜 두면 아래 anon 키는 공개 값이므로 누구나 스스로 계정을 만들어 "인증 사용자"가 되고,
#      쓰기 RLS 가 바로 그 문 뒤에 있어 전체 데이터를 지울 수 있습니다.
#   2. SQL Editor 에서 supabase/migrations/*.sql 을 번호순으로 **파일 전체** 실행
#      (0002 가 쓰기 권한을 관리자 계정 하나로 좁히고, 0003 통계·0004 정리 함수를 만듭니다).
#
#   두 가지 모두 `npx tsx scripts/verify-schema.ts` 가 확인합니다 —
#   검사 ⑦ 이 1번(signup 설정)을, 검사 ⑧⑨⑩⑪ 이 2번(0002·0003·0004·0006 대표 계약)을 봅니다.
#   새 프로젝트를 세운 뒤 반드시 한 번 돌려 11종이 전부 통과하는지 보세요.
#   role/ACL/Cron catalog 전체 계약은 admin test DSN을 process env에만 넣고
#   `npm run verify:discord-ingest -- --preflight`로 별도 확인합니다.

# Supabase 프로젝트 URL. 예: https://abcdefghijklmnop.supabase.co
# 브라우저 번들에 그대로 실려도 되는 공개 값입니다.
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) 키. 브라우저에 노출되는 값이며, 실제 권한은 DB 의 RLS 정책이 정합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 키 — RLS 를 통째로 우회합니다. **절대 브라우저로 내보내지 마세요.**
# NEXT_PUBLIC_ 접두사를 붙이면 그 순간 공개 값이 됩니다. 운영 앱에서 자격이 닿는 곳은
# Storage REST 전용 boundary와 기존 관리 route뿐이며, 나머지는 운영 스크립트입니다:
#   - lib/supabase/admin.ts  (라우트 핸들러 — 서버 전용)
#   - lib/discord-favicon-storage.ts  (Discord favicon Storage REST 전용)
#   - scripts/lib/service-client.ts  (시드·파비콘 업로드 스크립트)
SUPABASE_SERVICE_ROLE_KEY=

# Discord bookmark hostname을 외부 Google favicon provider로 보내는 운영 privacy gate.
# **정확히 `true`일 때만** 서버 액션과 관리자 버튼이 활성화됩니다. 누락, 빈 값, `TRUE`, `1` 등은
# 모두 fail-closed합니다. privacy 검토·승인 전에는 false로 두고, 승인 후 Vercel 서버 환경변수에서만
# true로 변경하세요. reconciliation(기존 Storage 고아 객체 정리)은 이 gate와 무관하게 동작합니다.
DISCORD_FAVICON_PROVIDER_APPROVED=false

# Discord ingest 전용 PostgreSQL LOGIN role의 서버 전용 TLS DSN.
# Supabase의 anon/service-role key나 agent용 HMAC secret과 같은 값이 아닙니다. 운영자가 migration 적용 뒤
# 전용 role password를 별도 secret-generation 절차로 설정하고, Next.js/Vercel secret store에만 넣으세요.
# `sslmode=require`가 반드시 포함되어야 합니다. node-postgres 8.x에서 Supavisor CA 파일을 별도로
# 주입하지 않는 Vercel runtime은 `uselibpqcompat=true&gssencmode=disable`도 함께 사용해 암호화된
# libpq-compatible require 모드와 GSS 협상 비활성화를 명시합니다. agent host·Discord·Git에는 이 값을
# 전달하거나 기록하지 않습니다.
DISCORD_INGEST_DATABASE_URL=

# Discord ingest 요청 서명용 서버 전용 HMAC secret. DB password와 반드시 다른 임의 32-byte 이상 값을
# 발급해 Next.js/Vercel과 격리된 agent signing client의 secret store에만 각각 넣으세요.
# 예: 로컬 터미널에서 `openssl rand -hex 32`로 발급하되 출력값은 prompt·로그·Git에 붙이지 않습니다.
DISCORD_INGEST_HMAC_SECRET=

# 클릭 집계용 방문자 해시 솔트 — 원본 IP 를 저장하지 않기 위한 값입니다.
# 아무 긴 무작위 문자열이면 됩니다. 예: node -e "console.log(crypto.randomUUID())"
# 이 값을 바꾸면 기존 방문자 해시와 이어지지 않아 중복 방지 판정이 초기화됩니다.
CLICK_SALT=

# AI 의미 검색용 Gemini API 키 (Google AI Studio). **서버 전용** — 절대 브라우저로 내보내지 마세요.
# 비워 두면 AI 검색이 조용히 이름(키워드) 검색으로 폴백합니다("준비 중" 안내) — 앱은 정상 동작.
# 배포(Vercel) 시 이 키도 Production/Preview 에 등록해야 AI 검색이 켜집니다.
AI_SEARCH_API_KEY=
