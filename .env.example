# 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#
#   PowerShell:  Copy-Item .env.example .env.local
#
# NEXT_PUBLIC_* 두 개는 Supabase 대시보드 → Project Settings → API 에 있습니다.
# 값을 바꾼 뒤에는 `next dev` 를 다시 시작해야 반영됩니다.
# 배포 환경(Vercel)에도 같은 4개를 등록해야 합니다 — Production/Preview 모두.
#
# ⚠️ Supabase 프로젝트 필수 설정 (키만 채워서는 안전하지 않습니다)
#
#   1. Authentication → Sign In / Up → "Allow new users to sign up" **끄기**
#      (익명 로그인도 같은 화면에서 끕니다).
#      켜 두면 아래 anon 키는 공개 값이므로 누구나 스스로 계정을 만들어 "인증 사용자"가 되고,
#      쓰기 RLS 가 바로 그 문 뒤에 있어 전체 데이터를 지울 수 있습니다.
#   2. SQL Editor 에서 supabase/migrations/*.sql 을 번호순으로 **파일 전체** 실행
#      (0002 가 쓰기 권한을 관리자 계정 하나로 좁히고, 0003 통계·0004 정리 함수를 만듭니다).
#
#   두 가지 모두 `npx tsx scripts/verify-schema.ts` 가 확인합니다 —
#   검사 ⑦ 이 1번(signup 설정)을, 검사 ⑧⑨⑩ 이 2번(0002·0003·0004 적용 여부)을 봅니다.
#   새 프로젝트를 세운 뒤 반드시 한 번 돌려 10종이 전부 통과하는지 보세요
#   (마이그레이션 0002·0003·0004 를 전부 적용한 뒤여야 ⑧⑨⑩ 이 통과합니다).

# Supabase 프로젝트 URL. 예: https://abcdefghijklmnop.supabase.co
# 브라우저 번들에 그대로 실려도 되는 공개 값입니다.
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) 키. 브라우저에 노출되는 값이며, 실제 권한은 DB 의 RLS 정책이 정합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 키 — RLS 를 통째로 우회합니다. **절대 브라우저로 내보내지 마세요.**
# NEXT_PUBLIC_ 접두사를 붙이면 그 순간 공개 값이 됩니다. 쓰는 곳은 두 군데뿐입니다:
#   - lib/supabase/admin.ts  (라우트 핸들러 — 서버 전용)
#   - scripts/lib/service-client.ts  (시드·파비콘 업로드 스크립트)
SUPABASE_SERVICE_ROLE_KEY=

# 클릭 집계용 방문자 해시 솔트 — 원본 IP 를 저장하지 않기 위한 값입니다.
# 아무 긴 무작위 문자열이면 됩니다. 예: node -e "console.log(crypto.randomUUID())"
# 이 값을 바꾸면 기존 방문자 해시와 이어지지 않아 중복 방지 판정이 초기화됩니다.
CLICK_SALT=
